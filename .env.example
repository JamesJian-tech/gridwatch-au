# Copy to .env (git-ignored). Read by docker compose (DORIS_VERSION) and by
# `set -a; . ./.env; set +a` before running `python -m nemdoris`.

# Doris image tag: apache/doris:fe-<version> / be-<version>
DORIS_VERSION=4.1.3

# Collector -> Doris connection
DORIS_HOST=127.0.0.1
DORIS_HTTP_PORT=8030
DORIS_QUERY_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DB=nem
